---
import HomeButton from "../components/HomeButton.astro";
import CompletionDialog from "../components/onehot/CompletionDialog.astro";
import GameHud from "../components/onehot/GameHud.astro";
import GameStage from "../components/onehot/GameStage.astro";
import OnehotHelp from "../components/onehot/OnehotHelp.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Onehot | Kahnpoint"
  bodyClass="overflow-hidden font-sans"
  viewport="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no"
>
  <GameStage />
  <GameHud />
  <HomeButton />
  <OnehotHelp />
  <CompletionDialog />
</Layout>

<style is:global>
  html {
    scrollbar-gutter: auto;
    overflow: hidden;
    background: white;
  }

  html,
  body {
    touch-action: none;
    overscroll-behavior: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }
</style>
