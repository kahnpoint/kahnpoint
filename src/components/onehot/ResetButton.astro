<onehot-reset>
  <button
    type="button"
    aria-label="Restart game"
    data-reset-open
    class="flex size-10 cursor-pointer items-center justify-center border-4 border-neutral-900 bg-white text-xl text-neutral-900 hover:bg-neutral-100"
  >
    <i class="ph-bold ph-arrow-counter-clockwise" aria-hidden="true"></i>
  </button>
  <dialog
    aria-labelledby="restart-dialog-title"
    closedby="any"
    class="m-auto w-[calc(100vw-2rem)] max-w-sm border-4 border-neutral-900 bg-white p-6 text-neutral-900 backdrop:bg-white/70"
  >
    <h1 id="restart-dialog-title" class="text-2xl">
      Restart Onehot?
    </h1>
    <p class="mt-3">This clears your board, points, and level.</p>
    <form method="dialog" class="mt-6 flex justify-end gap-3">
      <button
        value="cancel"
        autofocus
        class="cursor-pointer border-4 border-neutral-900 px-3 py-2 hover:bg-neutral-100"
      >
        Cancel
      </button>
      <button
        value="restart"
        class="cursor-pointer border-4 border-neutral-900 px-3 py-2 hover:bg-neutral-100"
      >
        Restart
      </button>
    </form>
  </dialog>
</onehot-reset>

<script>
  class OnehotReset extends HTMLElement {
    connectedCallback(): void {
      const dialog = this.querySelector("dialog");
      const openButton = this.querySelector("[data-reset-open]");
      if (!dialog || !openButton) return;
      openButton.addEventListener("click", () => {
        dialog.returnValue = "cancel";
        dialog.showModal();
        this.dispatchEvent(
          new CustomEvent("onehot-modal-toggle", { bubbles: true }),
        );
      });
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close("cancel");
      });
      dialog.addEventListener("close", () => {
        if (dialog.returnValue === "restart")
          this.dispatchEvent(
            new CustomEvent("onehot-restart", { bubbles: true }),
          );
        this.dispatchEvent(
          new CustomEvent("onehot-modal-toggle", { bubbles: true }),
        );
      });
    }
  }

  customElements.define("onehot-reset", OnehotReset);
</script>
