---
import { TOTAL_LEVELS } from "../../games/onehot/board/core/target-patterns";
---

<div
  aria-label="Score and difficulty"
  class="pointer-events-none fixed top-[max(5rem,calc(env(safe-area-inset-top)+3.5rem))] left-1/2 z-10 grid h-12 w-72 max-w-[calc(100vw-3rem)] -translate-x-1/2 grid-cols-[1fr_auto] items-center gap-4 border-4 border-neutral-900 bg-white px-4 text-base whitespace-nowrap text-neutral-900 tabular-nums min-[640px]:top-[max(1.5rem,env(safe-area-inset-top))]"
>
  <span>
    <span data-onehot-points>0</span> points
  </span>
  <span data-onehot-level>Level 1/{TOTAL_LEVELS}</span>
</div>
