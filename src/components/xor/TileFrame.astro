---
import { TILE_PIXELS } from "../../games/xor/constants";
import { TONES } from "./scene-units";
import type { Tone } from "./scene-units";

interface Props {
  cell: number;
  frame: Tone;
  inside?: Tone | "none";
  cornerless?: boolean;
  class?: string;
}

const {
  cell,
  frame,
  inside = "paper",
  cornerless = false,
  class: className,
} = Astro.props;

const side = TILE_PIXELS - 2;
const outline = cornerless
  ? `M1 0h${side}v1h1v${side}h-1v1h-${side}v-1h-1v-${side}h1z`
  : `M0 0h${TILE_PIXELS}v${TILE_PIXELS}h-${TILE_PIXELS}z`;
const hole = `M1 1h${side}v${side}h-${side}z`;
---

<g transform={`translate(${cell * TILE_PIXELS} 0)`} class={className}>
  <path fill-rule="evenodd" fill={TONES[frame]} d={`${outline} ${hole}`}></path>
  {inside !== "none" && (
    <rect x="1" y="1" width={side} height={side} fill={TONES[inside]} />
  )}
</g>
