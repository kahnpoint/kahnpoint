---
import { ageInYears, me } from "../data/me";
import IconList from "./IconList.astro";
import PostList from "./PostList.astro";
import ProfileHeader from "./ProfileHeader.astro";
import ProjectList from "./ProjectList.astro";
import SectionHeading from "./SectionHeading.astro";

const links = [
  { label: "Resume", url: "./resume", icon: "read-cv-logo" },
  ...me.links,
];
const stats = [
  { label: `${ageInYears(me.birthDate)} y/o`, icon: "cake" },
  ...me.stats,
];

const iconSections = [
  { title: "Links", items: links },
  { title: "Stats", items: stats },
  { title: "Skills", items: me.skills },
];
---

<section class="space-y-4">
  <ProfileHeader name={`${me.name.first} ${me.name.last}`} bio={me.bio} />

  {iconSections.map(({ title, items }) => (
    <section class="space-y-4">
      <SectionHeading title={title} />
      <IconList items={items} />
    </section>
  ))}

  <section class="space-y-4">
    <SectionHeading title="Projects" />
    <ProjectList projects={me.projects} />
  </section>

  <section class="space-y-4">
    <SectionHeading title="Writings" />
    <PostList />
  </section>
</section>
